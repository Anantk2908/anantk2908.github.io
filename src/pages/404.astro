---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import { content, base, words } from "../lib/site";

// GitHub Pages serves this file for any missing address, at any folder depth,
// so every link on it starts from the site's base path instead of "./".
const { notFound } = content;
const lines = words(notFound.exact);
---

<Base title={`${notFound.title} | ${content.meta.name}`} path="404.html" assetRoot={base} noindex>
  <TopBar assetRoot={base} homeHref={base} />

  <main id="content" class="wrap not-found">
    <section class="hero" aria-labelledby="hero-title">
      <p class="hero-vague" aria-hidden="true">{notFound.vague}</p>
      <h1 class="hero-exact" id="hero-title" aria-label={notFound.exact.join(" ")}>
        {
          lines.map((line) => (
            <span class="line" aria-hidden="true">
              {line.map((w, n) => (
                <>
                  <span class="w" style={`--i:${w.i}`}>{w.word}</span>
                  {n < line.length - 1 ? " " : ""}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <div class="hero-rest">
        <p class="hero-intro">{notFound.body}</p>
        <p class="hero-actions"><a class="button" href={base}>{notFound.homeLabel}</a></p>
      </div>
    </section>
  </main>
</Base>
